---
import { Image } from 'astro:assets';
import { site, nav, services } from '../data/site';
import logo from '../assets/foto/logo-lsp-kunststoffen.webp';
const c = site.contact;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <Image src={logo} alt="Logo LSP Kunststoffen – uw partner in machinaal bewerkte kunststof producten" width={240} widths={[240, 480]} sizes="240px" class="footer__logo" loading="lazy" />
      <p>Machinaal bewerkte kunststoffen. Kunststof producten op maat, van ontwerp tot realisatie.</p>
      <div class="footer__social">
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LSP Kunststoffen op LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="LSP Kunststoffen op Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.4 1.5-1.4h1.5V4.5c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.3H8v3h2.6V21h2.9z"/></svg>
        </a>
      </div>
    </div>
    <nav aria-label="Footer menu">
      <p class="footer__title">Menu</p>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Diensten">
      <p class="footer__title">Diensten</p>
      <ul>{services.map((s) => <li><a href={`/diensten/${s.slug}`}>{s.title}</a></li>)}</ul>
    </nav>
    <address>
      <p class="footer__title">Bedrijfsinformatie</p>
      <p>{site.owner}<br /><a href={c.maps} target="_blank" rel="noopener noreferrer">{c.street}<br />{c.postalCode} {c.city}</a></p>
      <p>
        <a href={`tel:${c.phone}`}>{c.phoneDisplay}</a><br />
        <a href={`mailto:${c.email}`}>{c.email}</a>
      </p>
      <p class="footer__small">KvK: {c.kvk}<br />BTW: {c.btw}</p>
    </address>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}, Schijndel</p>
  </div>
</footer>

<style>
  .footer { background: var(--dark); color: #a9a49b; padding: 60px 0 0; font-size: .95rem; border-top: 3px solid var(--bronze); }
  .footer a { color: #e2ded7; text-decoration: none; }
  .footer a:hover { color: var(--bronze-light); }
  .footer__grid { display: grid; grid-template-columns: 1.5fr 1fr 1.3fr 1.3fr; gap: 36px; }
  .footer__logo { width: 220px; height: auto; margin-bottom: 14px; }
  .footer__title { color: #fff; font-weight: 700; margin-bottom: .9em; letter-spacing: .02em; }
  .footer ul { list-style: none; padding: 0; margin: 0; }
  .footer li { margin-bottom: .45em; }
  .footer address { font-style: normal; }
  .footer__small { font-size: .85rem; }
  .footer__social { display: flex; gap: 10px; }
  .footer__social a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #3a3a3a; border-radius: 6px; }
  .footer__social a:hover { border-color: var(--bronze); }
  .footer__bottom { border-top: 1px solid #2a2a2a; margin-top: 44px; padding: 20px; font-size: .85rem; }
  .footer__bottom p { margin: 0; }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
