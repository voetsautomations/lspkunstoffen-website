---
// Zet foto's (jpg/png/webp) in src/assets/galerij/ — ze verschijnen hier automatisch,
// geoptimaliseerd (webp, juiste formaten, lazy loading). De bestandsnaam wordt de alt-tekst,
// dus gebruik beschrijvende namen, bv. "pe-plaat-gefreesd.jpg".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { limit?: number }
const { limit } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/galerij/*.{jpg,jpeg,png,webp}', { eager: true });
const images = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default,
    alt: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' '),
  }))
  .slice(0, limit);
const placeholders = images.length ? 0 : (limit ?? 6);
---
<div class="gallery">
  {images.map((img) => (
    <figure>
      <Image src={img.src} alt={img.alt} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 33vw" loading="lazy" />
    </figure>
  ))}
  {Array.from({ length: placeholders }).map((_, i) => (
    <div class="placeholder-img" aria-hidden="true">Project {i + 1}</div>
  ))}
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .gallery figure { margin: 0; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .gallery figure:hover :global(img) { transform: scale(1.04); }
</style>
