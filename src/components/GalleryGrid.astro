---
// Zet foto's (jpg/png/webp) in src/assets/galerij/ — ze verschijnen hier automatisch,
// geoptimaliseerd (webp, juiste formaten, lazy loading). De bestandsnaam wordt de alt-tekst,
// dus gebruik beschrijvende namen, bv. "pe-plaat-gefreesd.jpg".
import { Image } from 'astro:assets';
import { galleryImages, widthsFor } from '../data/images';

interface Props { limit?: number; captions?: boolean }
const { limit, captions = false } = Astro.props;
const images = galleryImages.slice(0, limit);
---
<div class="gallery">
  {images.map((img) => (
    <figure>
      <Image src={img.src} alt={img.alt} widths={widthsFor(img.src, [400, 800])} sizes="(max-width: 640px) 100vw, 33vw" loading="lazy" />
      {captions && <figcaption>{img.alt}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .gallery figure { margin: 0; position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--dark); }
  .gallery :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .gallery figure:hover :global(img) { transform: scale(1.04); }
  figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 28px 16px 12px;
    color: #fff; font-size: .9rem; font-weight: 500;
    background: linear-gradient(transparent, rgba(0,0,0,.75));
  }
</style>
