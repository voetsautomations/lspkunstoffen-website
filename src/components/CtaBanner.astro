---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Een project in kunststof?',
  text = 'Vertel ons wat u nodig heeft. We denken graag mee en sturen snel een vrijblijvende offerte.',
} = Astro.props;
---
<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a href="/contact" class="btn btn--light">Offerte aanvragen</a>
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="btn btn--ghost cta__ghost">{site.contact.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--green); color: #fff; padding: 56px 0; }
  .cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .cta h2 { margin-bottom: .3em; }
  .cta p { margin: 0; opacity: .9; max-width: 560px; }
  .cta__ghost { color: #fff; border-color: #fff; }
  .cta__ghost:hover { background: #fff; color: var(--green-dark); }
</style>
