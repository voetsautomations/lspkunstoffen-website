---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBanner from '../components/CtaBanner.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
---
<Base title="Galerij" description="Voorbeelden van kunststof producten van LSP Kunststoffen: CNC-freeswerk, draaiwerk, gelaste constructies en maatwerk.">
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/galerij', label: 'Galerij' }]} />
      <h1>Galerij</h1>
      <p class="lead">Enkele voorbeelden van producten uit onze werkplaats. Benieuwd wat we voor u kunnen maken? <a href="/diensten">Bekijk onze diensten</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <GalleryGrid captions />
    </div>
  </section>

  <CtaBanner title="Zoiets nodig?" text="Stuur ons uw tekening of idee en we maken een vrijblijvende offerte." />
</Base>
