---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina niet gevonden">
  <section class="section">
    <div class="container" style="text-align:center;max-width:560px">
      <h1>Pagina niet gevonden</h1>
      <p class="lead">Deze pagina bestaat niet (meer). Misschien vindt u hier wat u zoekt:</p>
      <div class="btn-row" style="justify-content:center">
        <a href="/" class="btn">Naar home</a>
        <a href="/diensten" class="btn btn--ghost">Diensten</a>
        <a href="/contact" class="btn btn--ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>
