---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, site, type Service } from '../../data/site';
import { getImage, widthsFor } from '../../data/images';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug);
const img = getImage(service.image);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.title,
    description: service.intro,
    provider: { '@id': `${site.url}/#bedrijf` },
    areaServed: 'NL',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Diensten', item: `${site.url}/diensten` },
      { '@type': 'ListItem', position: 3, name: service.title, item: `${site.url}/diensten/${service.slug}` },
    ],
  },
];
---
<Base title={`${service.title} in Schijndel`} description={`${service.short} ${site.name} in Schijndel – vraag vrijblijvend een offerte aan.`} schema={schema}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/diensten', label: 'Diensten' }, { href: `/diensten/${service.slug}`, label: service.title }]} />
      <h1>{service.title}</h1>
      <p class="lead">{service.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div>
        <h2>Wat wij voor u kunnen doen</h2>
        <ul class="checklist">{service.points.map((p) => <li>{p}</li>)}</ul>
        <div class="btn-row">
          <a href="/contact" class="btn">Offerte aanvragen</a>
          <a href="/galerij" class="btn btn--ghost">Bekijk ons werk</a>
        </div>
      </div>
      {img && (
        <div class="photo service__photo">
          <Image src={img.src} alt={img.alt} widths={widthsFor(img.src, [480, 800, 1100])} sizes="(max-width: 900px) 100vw, 540px" loading="eager" />
        </div>
      )}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Andere diensten</h2>
      <div class="grid grid--3">
        {others.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .service__photo { aspect-ratio: 4 / 3; }
  .grid--3 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
</style>
