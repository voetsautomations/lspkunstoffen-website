---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../data/site';
---
<Base title="Diensten" description="CNC-frezen, draaien & frezen, kunststof lassen en maatwerk van ontwerp tot realisatie. Bekijk de diensten van LSP Kunststoffen in Schijndel.">
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/diensten', label: 'Diensten' }]} />
      <h1>Onze diensten</h1>
      <p class="lead">Van een enkel onderdeel tot een compleet product: wij bewerken kunststof met ons eigen machinepark in Schijndel.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--4">
      {services.map((s) => <ServiceCard service={s} heading="h2" />)}
    </div>
  </section>

  <CtaBanner title="Staat uw vraag er niet tussen?" text="Neem gerust contact op. In kunststof is vaak meer mogelijk dan u denkt." />
</Base>
