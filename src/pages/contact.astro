---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, services } from '../data/site';
const c = site.contact;
const tel = c.phone.replace(/\s/g, '');
---
<Base title="Contact" description={`Neem contact op met ${site.name} voor een vrijblijvende offerte. Bel ${c.phoneDisplay} of mail ${c.email}.`}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/contact', label: 'Contact' }]} />
      <h1>Contact</h1>
      <p class="lead">Vraag een offerte aan of stel uw vraag. We reageren meestal binnen één werkdag.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2 contact">
      <div class="card">
        <h2 class="h3">Direct contact</h2>
        <ul class="contact__list">
          <li><span>Telefoon</span><a href={`tel:${tel}`}>{c.phoneDisplay}</a></li>
          <li><span>E-mail</span><a href={`mailto:${c.email}`}>{c.email}</a></li>
          <li><span>Adres</span>{c.street}, {c.postalCode} {c.city}</li>
          <li><span>LinkedIn</span><a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LSP Kunststoffen</a></li>
          <li><span>KvK</span>{c.kvk}</li>
        </ul>
        <div class="btn-row">
          <a href={`tel:${tel}`} class="btn">Bel direct</a>
          <a href={`mailto:${c.email}?subject=Offerteaanvraag`} class="btn btn--ghost">Mail ons</a>
        </div>
      </div>
      <div>
        <h2 class="h3">Handig om mee te sturen</h2>
        <ul class="checklist">
          <li>Een tekening, schets of foto</li>
          <li>Afmetingen en gewenste aantallen</li>
          <li>Het soort kunststof (als u dat weet)</li>
          <li>Gewenste levertermijn</li>
        </ul>
        <p>Waar kunnen we u mee helpen?</p>
        <ul class="links">
          {services.map((s) => <li><a href={`/diensten/${s.slug}`}>{s.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .h3 { font-size: 1.3rem; }
  .contact { align-items: start; }
  .contact__list { list-style: none; padding: 0; margin: 0 0 1.5em; }
  .contact__list li { display: grid; grid-template-columns: 90px 1fr; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .contact__list span { color: var(--muted); font-size: .9rem; }
  .links { padding-left: 1.2em; }
</style>
