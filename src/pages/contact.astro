---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, services } from '../data/site';
const c = site.contact;
---
<Base title="Contact" description={`Neem contact op met ${site.name} in Schijndel. Bel ${c.phoneDisplay} of mail ${c.email} voor een vrijblijvende offerte.`}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/contact', label: 'Contact' }]} />
      <h1>Contact</h1>
      <p class="lead">Vraag een offerte aan of stel uw vraag. Bellen, mailen of langskomen kan allemaal.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2 contact">
      <div class="card contact__card">
        <h2 class="h3">{site.name}</h2>
        <ul class="contact__list">
          <li><span>Contactpersoon</span>{site.owner}</li>
          <li><span>Telefoon</span><a href={`tel:${c.phone}`}>{c.phoneDisplay}</a></li>
          <li><span>E-mail</span><a href={`mailto:${c.email}`}>{c.email}</a></li>
          <li><span>Adres</span><a href={c.maps} target="_blank" rel="noopener noreferrer">{c.street}, {c.postalCode} {c.city}</a></li>
          <li><span>KvK</span>{c.kvk}</li>
          <li><span>BTW</span>{c.btw}</li>
        </ul>
        <div class="btn-row">
          <a href={`tel:${c.phone}`} class="btn">Bel direct</a>
          <a href={`mailto:${c.email}?subject=Offerteaanvraag`} class="btn btn--ghost">Mail ons</a>
          <a href={c.maps} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">Route</a>
        </div>
      </div>
      <div>
        <h2 class="h3">Handig om mee te sturen</h2>
        <ul class="checklist">
          <li>Een tekening, schets of foto</li>
          <li>Afmetingen en gewenste aantallen</li>
          <li>Het soort kunststof (als u dat weet)</li>
          <li>Gewenste levertermijn</li>
        </ul>
        <p>Waar kunnen we u mee helpen?</p>
        <ul class="links">
          {services.map((s) => <li><a href={`/diensten/${s.slug}`}>{s.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .h3 { font-size: 1.35rem; }
  .contact { align-items: start; }
  .contact__card { padding: 28px; border-top: 3px solid var(--bronze); }
  .contact__card:hover { transform: none; box-shadow: none; }
  .contact__list { list-style: none; padding: 0; margin: 0 0 1.5em; }
  .contact__list li { display: grid; grid-template-columns: 120px 1fr; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .contact__list span { color: var(--muted); font-size: .9rem; }
  .links { padding-left: 1.2em; }
  .links li::marker { color: var(--bronze); }
  @media (max-width: 420px) { .contact__list li { grid-template-columns: 1fr; gap: 0; } }
</style>
