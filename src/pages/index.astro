---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site, services, usps } from '../data/site';
import { getImage, widthsFor } from '../data/images';
import bus from '../assets/foto/bedrijfsbus.png';

const hero = getImage('zwarte-frees-onderdelen-op-maat')!;
---
<Base title={site.name}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="eyebrow">{site.slogan}</span>
        <h1>Van ontwerp tot realisatie.<br /><span>LSP Kunststoffen</span> tot uw dienst.</h1>
        <p class="hero__lead">
          CNC-frezen, draaien en lassen van kunststof in Schijndel. Wij maken uw onderdeel of product precies op maat,
          van één prototype tot een serie.
        </p>
        <div class="btn-row">
          <a href="/contact" class="btn">Vraag een offerte aan</a>
          <a href="/diensten" class="btn btn--ghost-light">Bekijk onze diensten</a>
        </div>
      </div>
      <div class="hero__photo">
        <Image src={hero.src} alt="Op maat gefreesde zwarte kunststof onderdelen" widths={widthsFor(hero.src, [480, 800, 1200])} sizes="(max-width: 900px) 100vw, 540px" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Diensten</span>
        <h2>Machinaal bewerkte kunststoffen</h2>
        <p class="lead">Met ons eigen machinepark bewerken we kunststof op elke manier die uw project vraagt.</p>
      </div>
      <div class="grid grid--4">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container grid grid--2">
      <div class="photo about__photo">
        <Image src={bus} alt="Bedrijfsbus van LSP Kunststoffen in Schijndel" widths={widthsFor(bus, [480])} sizes="(max-width: 900px) 100vw, 520px" loading="lazy" />
      </div>
      <div>
        <span class="eyebrow">Over ons</span>
        <h2>Uw partner in kunststofbewerking</h2>
        <p>
          LSP Kunststoffen is het bedrijf van Leon Sprokholt. Vanuit onze werkplaats in Schijndel helpen we u met
          bijna al uw wensen op het gebied van kunststofbewerking en kunststof lassen.
        </p>
        <ul class="usps">
          {usps.map((u) => <li><strong>{u.title}</strong> – {u.text}</li>)}
        </ul>
        <a href="/over-ons" class="btn btn--ghost-light">Meer over ons en ons machinepark</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Galerij</span>
        <h2>Enkele voorbeelden van producten</h2>
      </div>
      <GalleryGrid limit={6} />
      <p class="more"><a href="/galerij" class="card__link">Bekijk de volledige galerij</a></p>
    </div>
  </section>

  <CtaBanner />
</Base>

<style>
  .hero { background: radial-gradient(ellipse at 80% 20%, #2a241a 0%, var(--dark) 60%); color: #d9d5ce; padding: 80px 0; }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .hero .eyebrow { color: var(--bronze-light); }
  .hero h1 { color: #fff; }
  .hero h1 span { color: var(--bronze); }
  .hero__lead { font-size: 1.15rem; color: #cfcac2; margin-bottom: 1.8em; max-width: 540px; }
  .hero__photo { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; box-shadow: 0 24px 60px rgba(0,0,0,.5); border: 1px solid #333; }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .about__photo { aspect-ratio: 4 / 3; }
  .usps { padding-left: 1.1em; margin: 0 0 1.6em; }
  .usps li { margin-bottom: .5em; }
  .usps li::marker { color: var(--bronze); }
  .usps strong { color: #fff; }
  .more { margin-top: 24px; }
  @media (max-width: 900px) {
    .hero { padding: 56px 0; }
    .hero__grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
